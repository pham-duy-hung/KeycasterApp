<Window x:Class="keycasterApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keycaster Overlay" Height="200" Width="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Loaded="Window_Loaded">

    <Grid VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="20">
        <!-- Khung hiển thị thao tác -->
        <Border x:Name="OverlayBorder"
                Background="#CC1E1E1E" 
                CornerRadius="10" 
                Padding="15,10"
                Opacity="0">
            <StackPanel Orientation="Horizontal">
                <!-- Icon/Text hiển thị Chuột -->
                <TextBlock x:Name="MouseText" 
                           Foreground="#00E676" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           Margin="0,0,10,0" 
                           VerticalAlignment="Center"/>

                <!-- Text hiển thị Phím bấm -->
                <TextBlock x:Name="KeyText" 
                           Foreground="White" 
                           FontSize="22" 
                           FontWeight="Bold" 
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>