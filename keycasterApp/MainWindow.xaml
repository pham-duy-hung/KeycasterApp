<Window x:Class="keycasterApp.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeyCaster &amp; AutoClicker" Height="350" Width="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        Loaded="Window_Loaded">

    <Grid Margin="10">
        <!-- Bảng điều khiển AutoClicker (Giao diện chính) -->
        <Border Background="#252526" CornerRadius="12" Padding="15" VerticalAlignment="Top" HorizontalAlignment="Stretch">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="⚡ AUTOCLICKER CONTROL" Foreground="#00E676" FontWeight="Bold" FontSize="14"/>
                    <Button Content="✕" Click="CloseButton_Click" Foreground="White" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" FontWeight="Bold" Cursor="Hand"/>
                </DockPanel>

                <!-- Cài đặt Khoảng thời gian (Interval) -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Interval (ms):" Foreground="White" VerticalAlignment="Center" Width="100"/>
                    <TextBox x:Name="TxtInterval" Text="100" Width="80" Padding="3" Background="#333337" Foreground="White" BorderBrush="#555555"/>
                    <TextBlock Text="ms (100ms = 10 clicks/s)" Foreground="#AAAAAA" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Chọn Loại Click -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Loại Click:" Foreground="White" VerticalAlignment="Center" Width="100"/>
                    <ComboBox x:Name="CboClickType" Width="120" SelectedIndex="0" Background="#333337" Foreground="Black">
                        <ComboBoxItem Content="Chuột trái (Left)"/>
                        <ComboBoxItem Content="Chuột phải (Right)"/>
                        <ComboBoxItem Content="Giữ chuột trái (Hold)"/>
                    </ComboBox>
                </StackPanel>

                <!-- Cài đặt Hotkey -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="Hotkey Bật/Tắt:" Foreground="White" VerticalAlignment="Center" Width="100"/>
                    <TextBlock Text="[ F6 ]" Foreground="#FFD700" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Nút Bật / Dừng -->
                <Button x:Name="BtnToggleAutoClick" Content="BẬT AUTOCLICK (F6)" Click="BtnToggleAutoClick_Click" 
                        Background="#007ACC" Foreground="White" FontWeight="Bold" Padding="8" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <!-- Khung Overlay hiển thị phím/chuột (Keycaster) -->
        <Border x:Name="OverlayBorder" Background="#CC1E1E1E" CornerRadius="10" Padding="15,10" Opacity="0"
                VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,10,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="MouseText" Foreground="#00E676" FontSize="20" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="KeyText" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>