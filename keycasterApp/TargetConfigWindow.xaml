<Window x:Class="keycasterApp.TargetConfigWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cấu hình Ô" Height="260" Width="320"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#2D2D30">

    <StackPanel Margin="15">
        <TextBlock Text="⚙️ CẤU HÌNH THAO TÁC" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>

        <!-- Loại thao tác -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Loại:" Foreground="White" Width="90" VerticalAlignment="Center"/>
            <ComboBox x:Name="CboType" Width="170" SelectionChanged="CboType_SelectionChanged">
                <ComboBoxItem Content="Click chuột trái"/>
                <ComboBoxItem Content="Click chuột phải"/>
                <ComboBoxItem Content="Giữ chuột trái"/>
                <ComboBoxItem Content="Gõ phím bàn phím"/>
            </ComboBox>
        </StackPanel>

        <!-- Nhập phím (Nếu chọn KeyPress) -->
        <StackPanel x:Name="PanelKey" Orientation="Horizontal" Margin="0,0,0,10" Visibility="Collapsed">
            <TextBlock Text="Phím gõ:" Foreground="White" Width="90" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtKey" Width="170" Padding="3" KeyDown="TxtKey_KeyDown" Text="A" PreviewKeyDown="TxtKey_PreviewKeyDown"/>
        </StackPanel>

        <!-- Delay ms -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="Delay (ms):" Foreground="White" Width="90" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtDelay" Width="170" Padding="3" Text="200"/>
        </StackPanel>

        <Button Content="LƯU CẤU HÌNH" Click="BtnSave_Click" Background="#007ACC" Foreground="White" FontWeight="Bold" Padding="8" BorderThickness="0"/>
    </StackPanel>
</Window>